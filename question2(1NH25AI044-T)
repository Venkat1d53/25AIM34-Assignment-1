def print_step(step_name, binary_str, carry=None):
    """Helper function to cleanly format the step-by-step display."""
    c_str = f" [Carry: {carry}]" if carry is not None else ""
    print(f"  -> {step_name:<15}: {binary_str}{c_str}")

def rotate_left_without_carry(value, positions, bits=8):
    """Performs Rotate Left (ROL) and logs intermediate steps."""
    print(f"\n--- Rotate Left Without Carry (ROL) by {positions} positions ---")
    current = value & ((1 << bits) - 1)
    print_step("Original Data", f"{current:0{bits}b}")
    
    for i in range(1, positions + 1):
        # Extract the Most Significant Bit (MSB)
        msb = (current >> (bits - 1)) & 1
        # Shift left by 1 and place the old MSB into the Least Significant Bit (LSB) position
        current = ((current << 1) | msb) & ((1 << bits) - 1)
        print_step(f"After Step {i}", f"{current:0{bits}b}")
        
    return current

def rotate_left_with_carry(value, positions, initial_carry, bits=8):
    """Performs Rotate Left through Carry (RCL) and logs intermediate steps."""
    print(f"\n--- Rotate Left With Carry (RCL) by {positions} positions ---")
    current_val = value & ((1 << bits) - 1)
    current_carry = initial_carry & 1
    print_step("Original Data", f"{current_val:0{bits}b}", current_carry)
    
    for i in range(1, positions + 1):
        # The outgoing MSB will become the next Carry flag
        next_carry = (current_val >> (bits - 1)) & 1
        # Shift value left, and pull the old Carry flag into the LSB position
        current_val = ((current_val << 1) | current_carry) & ((1 << bits) - 1)
        # Update current carry status
        current_carry = next_carry
        print_step(f"After Step {i}", f"{current_val:0{bits}b}", current_carry)
        
    return current_val, current_carry

# --- Execution ---
original_num = 0b10110110  # 182 in decimal

# a) Rotate left without carry (ROL) by 2 positions
rol_res = rotate_left_without_carry(original_num, positions=2)

# b) Rotate left with carry (RCL) by 2 positions (assuming an initial Carry = 0)
rcl_res_val, rcl_res_c = rotate_left_with_carry(original_num, positions=2, initial_carry=0)
